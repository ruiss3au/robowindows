From: RoboWindows contributors
Subject: [PATCH] dynrec: charge completed REP elements in bounded string helpers

Against DOSBox Pure 7f6e8fb7385fa446d1444d671063268520bf9b54 after patches
0001-0007. GPL-2.0-or-later, matching the upstream source.

Reserve cycles even when the repeat fits the available budget. Refund the
faulting and unexecuted elements before the existing precise exception handoff.
Reject nonpositive budgets before unsigned conversion, and scale backwards
indices without shifting negative signed values. Generated instruction overhead,
Normal execution, exception delivery, cache and linking remain unchanged.

Regression: tests/native/string_helpers_test.cpp extracts all 18 actual helpers.
The unchanged source-owned stress image supplies the device before/after gate.

--- a/src/cpu/core_dynrec/operators.h
+++ b/src/cpu/core_dynrec/operators.h
@@ -1647,9 +1647,11 @@
 static Bit16u DRC_CALL_CONV dynrec_movsb_word(Bit16u count,Bit16s add_index,PhysPt si_base,PhysPt di_base) DRC_FC;
 static Bit16u DRC_CALL_CONV dynrec_movsb_word(Bit16u count,Bit16s add_index,PhysPt si_base,PhysPt di_base) {
 	dynrec_string_exception=0;
+	if (CPU_Cycles<=0) return count;
 	Bit16u count_left;
 	if (count<(Bitu)CPU_Cycles) {
 		count_left=0;
+		CPU_Cycles-=count;
 	} else {
 		count_left=(Bit16u)(count-CPU_Cycles);
 		count=(Bit16u)CPU_Cycles;
@@ -1658,6 +1660,7 @@
 	for (;count>0;count--) {
 		Bit8u value;
 		if (mem_readb_checked(si_base+reg_si,&value) || mem_writeb_checked(di_base+reg_di,value)) {
+			CPU_Cycles+=count; // Refund the faulting and unexecuted elements.
 			dynrec_string_exception=1;
 			return (Bit16u)(count+count_left);
 		}
