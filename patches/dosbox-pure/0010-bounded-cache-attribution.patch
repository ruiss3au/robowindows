+// RoboWindows bounded diagnostic sampling; GPL-2.0-or-later.
+#ifndef ROBOWINDOWS_CACHE_TIMING_H
+#define ROBOWINDOWS_CACHE_TIMING_H
+#include <algorithm>
+#include <cstdint>
+
+#define RW_CACHE_COUNTS(X) \
+ X(lookup_hits) X(lookup_misses) X(translation_attempts) X(nested_attempts) \
+ X(stride_skipped) X(cap_skipped) X(samples_started) X(samples_completed) X(samples_discarded) \
+ X(publication_scopes) X(publication_skipped) X(invalidate_calls) X(clear_calls) \
+ X(clear_code_write) X(clear_cache_reclaim) X(clear_code_size) X(clear_page_pressure) \
+ X(clear_page_release) X(clear_other) X(clock_errors) X(scope_errors)
+#define RW_CACHE_TIMES(X) \
+ X(translation_wall_sample) X(translation_cpu_sample) \
+ X(publication_wall_sample) X(publication_cpu_sample)
+#define RW_CACHE_FIELDS(X) \
+ RW_CACHE_COUNTS(X) \
+ X(translation_wall_sample_us) X(translation_wall_sample_max_us) \
+ X(translation_cpu_sample_us) X(translation_cpu_sample_max_us) \
+ X(publication_wall_sample_us) X(publication_wall_sample_max_us) \
+ X(publication_cpu_sample_us) X(publication_cpu_sample_max_us)
+struct RWCacheSnapshot {
+#define RW_FIELD(n) uint64_t n = 0;
+ RW_CACHE_FIELDS(RW_FIELD)
+#undef RW_FIELD
+};
+// Duration totals stay in ns until the frontend drains a published aggregate.
+struct RWCacheTotals {
+ RWCacheSnapshot counts;
+#define RW_NS(n) uint64_t n##_ns=0, n##_max_ns=0;
+ RW_CACHE_TIMES(RW_NS)
+#undef RW_NS
+ void merge(const RWCacheTotals& b) {
+#define RW_SUM(n) counts.n+=b.counts.n;
+  RW_CACHE_COUNTS(RW_SUM)
+#undef RW_SUM
+#define RW_SUM_NS(n) n##_ns+=b.n##_ns; n##_max_ns=std::max(n##_max_ns,b.n##_max_ns);
+  RW_CACHE_TIMES(RW_SUM_NS)
+#undef RW_SUM_NS
+ }
+ RWCacheSnapshot snapshot() const {
+  RWCacheSnapshot out=counts;
+#define RW_US(n) out.n##_us=n##_ns/1000; out.n##_max_us=n##_max_ns/1000;
+  RW_CACHE_TIMES(RW_US)
+#undef RW_US
+  return out;
+ }
+};
+enum RWClearReason { RW_CLEAR_OTHER, RW_CLEAR_CODE_WRITE, RW_CLEAR_CACHE_RECLAIM,
+ RW_CLEAR_CODE_SIZE, RW_CLEAR_PAGE_PRESSURE, RW_CLEAR_PAGE_RELEASE };
+
+template<class Clock> class RWCacheTiming {
+public:
+ class TranslationScope;
+ class PublicationScope;
+private:
+ bool live_=false;
+ uint64_t serial_=0, outer_=0, depth_=0, publication_depth_=0;
+ RWClearReason reason_=RW_CLEAR_OTHER;
+ RWCacheTotals slice_;
+ TranslationScope* selected_=nullptr;
+ static bool elapsed(int64_t a,int64_t b,uint64_t& out,uint64_t& errors) {
+  if(a<0 || b<a) { ++errors; return false; }
+  out=uint64_t(b-a); return true;
+ }
+public:
+ // Depth and scoped reason survive frame/pause boundaries until stack unwind.
+ void begin(bool enabled) {
+  live_=enabled; ++serial_; outer_=0; slice_={};
+ }
+ void finish() {
+  if(selected_) selected_->discard();
+  live_=false;
+ }
+ const RWCacheTotals& totals() const { return slice_; }
+ void lookup(bool hit) {
+  if(!live_) return;
+  if(hit) ++slice_.counts.lookup_hits; else ++slice_.counts.lookup_misses;
+ }
+ void invalidate() { if(live_) ++slice_.counts.invalidate_calls; }
+ void clear() {
+  if(!live_) return;
+  ++slice_.counts.clear_calls;
+  switch(reason_) {
+   case RW_CLEAR_CODE_WRITE: ++slice_.counts.clear_code_write; break;
+   case RW_CLEAR_CACHE_RECLAIM: ++slice_.counts.clear_cache_reclaim; break;
+   case RW_CLEAR_CODE_SIZE: ++slice_.counts.clear_code_size; break;
+   case RW_CLEAR_PAGE_PRESSURE: ++slice_.counts.clear_page_pressure; break;
+   case RW_CLEAR_PAGE_RELEASE: ++slice_.counts.clear_page_release; break;
+   default: ++slice_.counts.clear_other; break;
+  }
+ }
+ class ReasonScope {
+  RWCacheTiming& p_; RWClearReason previous_; bool active_;
+ public:
+  ReasonScope(RWCacheTiming& p,RWClearReason r):p_(p),previous_(p.reason_),active_(p.live_) {
+   if(active_ && !(r==RW_CLEAR_PAGE_RELEASE && previous_!=RW_CLEAR_OTHER)) p_.reason_=r;
+  }
+  ~ReasonScope() { if(active_) p_.reason_=previous_; }
+  ReasonScope(const ReasonScope&)=delete;
+  ReasonScope& operator=(const ReasonScope&)=delete;
+ };
+ class TranslationScope {
+  friend class RWCacheTiming;
+  friend class PublicationScope;
+  RWCacheTiming& p_;
+  uint64_t serial_=0;
+  bool tracked_=false, active_=false, completed_=false, valid_=true;
+  int64_t wall_=0,cpu_=0;
+  uint64_t publication_attempts_=0;
+  RWCacheTotals sample_;
+  void discard() {
+   if(!active_) return;
+   active_=false; ++p_.slice_.counts.samples_discarded;
+   if(p_.selected_==this) p_.selected_=nullptr;
+  }
+ public:
+  explicit TranslationScope(RWCacheTiming& p):p_(p) {
+   if(!p.live_) return;
+   tracked_=true; serial_=p.serial_;
+   ++p.slice_.counts.translation_attempts;
+   if(p.depth_++ != 0) { ++p.slice_.counts.nested_attempts; return; }
+   const auto ordinal=++p.outer_;
+   if(p.slice_.counts.samples_started==4) { ++p.slice_.counts.cap_skipped; return; }
+   if((ordinal-1)%64) { ++p.slice_.counts.stride_skipped; return; }
+   ++p.slice_.counts.samples_started;
+   active_=true; p.selected_=this;
+   wall_=Clock::wall(); cpu_=Clock::cpu();
+  }
+  // Only the original call's normal return commits a timing sample.
+  void complete() { completed_=true; }
+  ~TranslationScope() {
+   if(!tracked_) return;
+   if(active_ && serial_==p_.serial_ && p_.live_) {
+    if(!completed_) discard();
+    else {
+     const auto cpu_end=Clock::cpu(), wall_end=Clock::wall();
+     uint64_t w=0,c=0;
+     const bool wall_ok=elapsed(wall_,wall_end,w,p_.slice_.counts.clock_errors);
+     const bool cpu_ok=elapsed(cpu_,cpu_end,c,p_.slice_.counts.clock_errors);
+     if(!valid_ || !wall_ok || !cpu_ok) discard();
+     else if(sample_.publication_wall_sample_ns>w || sample_.publication_cpu_sample_ns>c) {
+      ++p_.slice_.counts.scope_errors; discard();
+     } else {
+      sample_.counts.samples_completed=1;
+      sample_.translation_wall_sample_ns=sample_.translation_wall_sample_max_ns=w;
+      sample_.translation_cpu_sample_ns=sample_.translation_cpu_sample_max_ns=c;
+      p_.slice_.merge(sample_); active_=false; p_.selected_=nullptr;
+     }
+    }
+   }
+   if(p_.depth_) --p_.depth_; else if(p_.live_) ++p_.slice_.counts.scope_errors;
+  }
+  TranslationScope(const TranslationScope&)=delete;
+  TranslationScope& operator=(const TranslationScope&)=delete;
+ };
+ class PublicationScope {
+  RWCacheTiming& p_; TranslationScope* sample_=nullptr;
+  uint64_t serial_=0; bool tracked_=false;
+  int64_t wall_=0,cpu_=0;
+ public:
+  explicit PublicationScope(RWCacheTiming& p):p_(p) {
+   if(!p.live_ || !p.selected_) return;
+   tracked_=true; serial_=p.serial_;
+   if(p.publication_depth_++ != 0) return;
+   auto* t=p.selected_;
+   if(t->publication_attempts_++ >= 4) { ++t->sample_.counts.publication_skipped; return; }
+   sample_=t; wall_=Clock::wall(); cpu_=Clock::cpu();
+  }
+  ~PublicationScope() {
+   if(!tracked_) return;
+   if(sample_ && p_.live_ && serial_==p_.serial_ && sample_->active_) {
+    const auto cpu_end=Clock::cpu(), wall_end=Clock::wall();
+    uint64_t w=0,c=0;
+    const bool wall_ok=elapsed(wall_,wall_end,w,p_.slice_.counts.clock_errors);
+    const bool cpu_ok=elapsed(cpu_,cpu_end,c,p_.slice_.counts.clock_errors);
+    if(!wall_ok || !cpu_ok) sample_->valid_=false;
+    else {
+     auto& s=sample_->sample_; ++s.counts.publication_scopes;
+     s.publication_wall_sample_ns+=w; s.publication_cpu_sample_ns+=c;
+     s.publication_wall_sample_max_ns=std::max(s.publication_wall_sample_max_ns,w);
+     s.publication_cpu_sample_max_ns=std::max(s.publication_cpu_sample_max_ns,c);
+    }
+   }
+   if(p_.publication_depth_) --p_.publication_depth_;
+   else if(p_.live_) ++p_.slice_.counts.scope_errors;
+  }
+  PublicationScope(const PublicationScope&)=delete;
+  PublicationScope& operator=(const PublicationScope&)=delete;
+ };
+};
+#endif
