+struct RWCacheCalibration {
+ uint64_t mean_ns=0, cache_clock_reads=0, samples_completed=0;
+ uint64_t stride_skipped=0, cap_skipped=0, cache_events=0;
+ uint64_t clock_errors=0, accounting_errors=0;
+};
+// Calibration is local, before guest loading; counting clock reads is not on
+// the runtime path. Mode 0 disabled, 1 worker only, 2 sampled, 3 events only.
+struct RWCalibrationClock {
+ static uint64_t& reads() { static thread_local uint64_t n=0; return n; }
+ static int64_t wall() { ++reads(); return RWTimingClock::wall(); }
+ static int64_t cpu() { ++reads(); return RWTimingClock::cpu(); }
+};
+inline RWCacheCalibration RWCacheCalibrate(int mode) {
+ RWCacheCalibration out;
+ if(mode<0 || mode>3) { out.accounting_errors=1; return out; }
+ typedef RWTiming<RWCalibrationClock> Probe;
+ Probe probe; probe.configure(mode!=0,mode>=2);
+ RWCalibrationClock::reads()=0;
+ const auto start=RWTimingClock::wall();
+ for(unsigned i=0;i<2000;++i) {
+  probe.worker_begin();
+  for(unsigned j=0;j<512;++j) {
+   if(mode!=3) {
+    probe.event(RW_TRANSLATE);
+    Probe::Cache::TranslationScope t(probe.cache());
+    for(unsigned k=0;k<4;++k) { Probe::Cache::PublicationScope pub(probe.cache()); }
+    t.complete();
+   }
+   probe.cache().lookup(false); probe.cache().invalidate();
+   Probe::Cache::ReasonScope reason(probe.cache(),RW_CLEAR_CODE_WRITE);
+   probe.cache().clear();
+  }
+  probe.worker_end();
+ }
+ const auto end=RWTimingClock::wall();
+ RWCacheSnapshot cache; const auto worker=probe.take(&cache);
+ const uint64_t expected_worker_reads=mode ? 8000 : 0;
+ if(RWCalibrationClock::reads()<expected_worker_reads) ++out.accounting_errors;
+ else out.cache_clock_reads=RWCalibrationClock::reads()-expected_worker_reads;
+ out.samples_completed=cache.samples_completed;
+ out.stride_skipped=cache.stride_skipped; out.cap_skipped=cache.cap_skipped;
+ out.cache_events=cache.lookup_misses+cache.invalidate_calls+cache.clear_calls;
+ out.clock_errors=worker.worker_clock_errors+cache.clock_errors;
+ if(start<0 || end<start) ++out.clock_errors;
+ else out.mean_ns=uint64_t(end-start)/2000;
+ const bool sampled=mode==2, events=mode>=2;
+ if(out.cache_clock_reads!=(sampled ? 160000u : 0u) ||
+    cache.samples_started!=(sampled ? 8000u : 0u) ||
+    out.samples_completed!=(sampled ? 8000u : 0u) || cache.samples_discarded ||
+    out.stride_skipped!=(sampled ? 378000u : 0u) ||
+    out.cap_skipped!=(sampled ? 638000u : 0u) ||
+    cache.publication_scopes!=(sampled ? 32000u : 0u) || cache.publication_skipped ||
+    cache.translation_attempts!=(sampled ? 1024000u : 0u) ||
+    worker.translations!=((mode==1 || mode==2) ? 1024000u : 0u) ||
+    out.cache_events!=(events ? 3072000u : 0u) || cache.scope_errors)
+  ++out.accounting_errors;
+ return out;
+}
