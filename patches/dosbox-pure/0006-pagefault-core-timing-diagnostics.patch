+static Bits robowindows_pagefault_core_return(Bits result,
+		const std::chrono::steady_clock::time_point &started) {
+	const unsigned long long duration_us = static_cast<unsigned long long>(
+		std::chrono::duration_cast<std::chrono::microseconds>(
+			std::chrono::steady_clock::now() - started).count());
+	++robowindows_pf_core_returns;
+	robowindows_pf_core_total_us += duration_us;
+	if (duration_us > robowindows_pf_core_max_us)
+		robowindows_pf_core_max_us = duration_us;
+	if (duration_us >= 10000) ++robowindows_pf_core_slow_10ms;
+	return result;
+}
