--- /dev/null
+++ b/include/robowindows_core_timing.h
@@ -0,0 +1,138 @@
+// RoboWindows aggregate diagnostics; GPL-2.0-or-later.
+#ifndef ROBOWINDOWS_CORE_TIMING_H
+#define ROBOWINDOWS_CORE_TIMING_H
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <ctime>
+#include <mutex>
+
+#define RW_TIMING_FIELDS(X) \
+ X(worker_slices) X(worker_wall_total_us) X(worker_wall_max_us) \
+ X(worker_cpu_total_us) X(worker_cpu_max_us) X(worker_clock_errors) \
+ X(wait_calls) X(wait_total_us) X(wait_max_us) \
+ X(mix_calls) X(mix_total_us) X(mix_max_us) X(frontend_clock_errors) \
+ X(translations) X(fallback_special) X(fallback_invalidated) \
+ X(fallback_opcode) X(fallback_smc) X(fallback_trap) X(discarded_slices)
+struct RWTimingSnapshot {
+#define RW_FIELD(n) uint64_t n = 0;
+ RW_TIMING_FIELDS(RW_FIELD)
+#undef RW_FIELD
+};
+enum RWTimingEvent { RW_TRANSLATE, RW_SPECIAL, RW_INVALIDATED, RW_OPCODE, RW_SMC, RW_TRAP };
+struct RWTimingClock {
+ static int64_t read(clockid_t clock) {
+  timespec t;
+  if (clock_gettime(clock, &t)) return -1;
+  return int64_t(t.tv_sec)*1000000000LL+t.tv_nsec;
+ }
+ static int64_t wall() { return read(CLOCK_MONOTONIC); }
+ static int64_t cpu() { return read(CLOCK_THREAD_CPUTIME_ID); }
+};
+// One emulation worker owns slice_, live_, and its clocks. The frontend never
+// touches them. Only completed slices cross the mutex; events take no locks.
+template<class Clock> class RWTiming {
+ std::atomic<uint64_t> generation_{0};
+ std::mutex mutex_;
+ RWTimingSnapshot pending_, slice_;
+ uint64_t worker_generation_ = 0;
+ bool live_ = false;
+ int64_t wall_start_ = 0, cpu_start_ = 0;
+ static uint64_t duration(int64_t start, int64_t end, uint64_t& errors) {
+  if (start < 0 || end < start) { ++errors; return 0; }
+  return uint64_t(end-start)/1000;
+ }
+ static void merge(RWTimingSnapshot& a, const RWTimingSnapshot& b) {
+#define RW_SUM(n) a.n += b.n;
+  // Max fields are corrected below after saving the previous values.
+  const auto wall = a.worker_wall_max_us, cpu = a.worker_cpu_max_us;
+  const auto wait = a.wait_max_us, mix = a.mix_max_us;
+  RW_TIMING_FIELDS(RW_SUM)
+#undef RW_SUM
+  a.worker_wall_max_us = std::max(wall,b.worker_wall_max_us);
+  a.worker_cpu_max_us = std::max(cpu,b.worker_cpu_max_us);
+  a.wait_max_us = std::max(wait,b.wait_max_us);
+  a.mix_max_us = std::max(mix,b.mix_max_us);
+ }
+public:
+ void configure(bool enabled) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  const auto old = generation_.load(std::memory_order_relaxed);
+  generation_.store(((old & ~uint64_t(1))+2) | uint64_t(enabled),std::memory_order_release);
+  pending_ = {};
+ }
+ void reset() { configure((generation_.load(std::memory_order_acquire)&1)!=0); }
+ uint64_t generation() const { return generation_.load(std::memory_order_acquire); }
+ void worker_begin() {
+  worker_generation_ = generation();
+  live_ = (worker_generation_ & 1)!=0;
+  if (!live_) return;
+  slice_ = {};
+  wall_start_ = Clock::wall(); cpu_start_ = Clock::cpu();
+ }
+ void event(RWTimingEvent event) {
+  if (!live_) return;
+  switch(event) {
+   case RW_TRANSLATE: ++slice_.translations; break;
+   case RW_SPECIAL: ++slice_.fallback_special; break;
+   case RW_INVALIDATED: ++slice_.fallback_invalidated; break;
+   case RW_OPCODE: ++slice_.fallback_opcode; break;
+   case RW_SMC: ++slice_.fallback_smc; break;
+   case RW_TRAP: ++slice_.fallback_trap; break;
+  }
+ }
+ void worker_end() {
+  if (!live_) return;
+  const auto cpu_end = Clock::cpu(), wall_end = Clock::wall();
+  live_ = false;
+  slice_.worker_slices = 1;
+  slice_.worker_wall_total_us = slice_.worker_wall_max_us =
+    duration(wall_start_,wall_end,slice_.worker_clock_errors);
+  slice_.worker_cpu_total_us = slice_.worker_cpu_max_us =
+    duration(cpu_start_,cpu_end,slice_.worker_clock_errors);
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (worker_generation_ == generation()) merge(pending_,slice_);
+  else if (generation() & 1) ++pending_.discarded_slices;
+ }
+ // Frontend scopes may be nested; totals are inclusive, not additive phases.
+ class FrontScope {
+  RWTiming& owner_;
+  uint64_t generation_;
+  bool mix_;
+  int64_t start_;
+ public:
+  FrontScope(RWTiming& owner, bool mix) : owner_(owner),
+    generation_(owner.generation()), mix_(mix),
+    start_((generation_ & 1) ? Clock::wall() : 0) {}
+  ~FrontScope() {
+   if (!(generation_ & 1)) return;
+   const auto end = Clock::wall();
+   std::lock_guard<std::mutex> lock(owner_.mutex_);
+   if (generation_ != owner_.generation()) return;
+   auto& p = owner_.pending_;
+   const auto us = duration(start_,end,p.frontend_clock_errors);
+   if (mix_) { ++p.mix_calls; p.mix_total_us+=us; p.mix_max_us=std::max(p.mix_max_us,us); }
+   else { ++p.wait_calls; p.wait_total_us+=us; p.wait_max_us=std::max(p.wait_max_us,us); }
+  }
+  FrontScope(const FrontScope&) = delete;
+  FrontScope& operator=(const FrontScope&) = delete;
+ };
+ RWTimingSnapshot take() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  const auto result = pending_; pending_ = {}; return result;
+ }
+};
+typedef RWTiming<RWTimingClock> RWCoreTiming;
+extern RWCoreTiming rw_core_timing;
+#if defined(__GNUC__)
+#define RW_TIMING_EXPORT __attribute__((visibility("default")))
+#else
+#define RW_TIMING_EXPORT
+#endif
+extern "C" {
+ RW_TIMING_EXPORT void robowindows_core_timing_configure(int enabled);
+ RW_TIMING_EXPORT void robowindows_core_timing_reset();
+ RW_TIMING_EXPORT void robowindows_core_timing_take(RWTimingSnapshot* out);
+ RW_TIMING_EXPORT uint64_t robowindows_core_timing_calibrate(int enabled);
+}
+#endif
