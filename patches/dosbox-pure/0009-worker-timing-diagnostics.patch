+extern "C" uint64_t robowindows_core_timing_calibrate(int enabled) {
+ RWCoreTiming probe;
+ probe.configure(enabled != 0);
+ const auto start = RWTimingClock::wall();
+ for (int i=0; i<2000; ++i) {
+  probe.worker_begin();
+  for (int j=0; j<64; ++j) probe.event(RW_TRANSLATE);
+  probe.worker_end();
+ }
+ const auto end = RWTimingClock::wall();
+ const auto sample = probe.take();
+ if (sample.translations != (enabled ? 128000u : 0u)) return 0;
+ return start < 0 || end < start ? 0 : uint64_t(end-start)/2000;
+}
