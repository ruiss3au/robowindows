<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RoboWindows" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/rw_background</item>
        <item name="android:colorAccent">@color/rw_primary</item>
        <item name="android:navigationBarColor">@color/rw_background</item>
        <item name="android:statusBarColor">@color/rw_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:alertDialogTheme">@style/Theme.RoboWindows.Dialog</item>
        <item name="android:textColorPrimary">@color/rw_text</item>
        <item name="android:textColorSecondary">@color/rw_text_muted</item>
        <item name="android:colorControlActivated">@color/rw_primary</item>
    </style>
    <style name="Theme.RoboWindows.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/classic_panel</item>
        <item name="android:colorAccent">@color/rw_primary</item>
        <item name="android:textColorPrimary">@color/rw_text</item>
        <item name="android:buttonBarButtonStyle">@style/ClassicDialogButton</item>
    </style>
    <style name="ClassicDialogButton" parent="android:style/Widget.Material.Light.Button.Borderless">
        <item name="android:background">@drawable/classic_panel</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/rw_text</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
</resources>
